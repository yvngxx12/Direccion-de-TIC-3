# Copiar este archivo como .env y completar.
PORT=4300

# --- YouTube (YouTube Data API v3) ---
# Google Cloud Console -> APIs y servicios -> Habilitar "YouTube Data API v3" -> Credenciales -> Clave de API
YOUTUBE_API_KEY=

# --- Twitch (opcional) ---
# https://dev.twitch.tv/console -> Registrar aplicación (URL de redirección: http://localhost)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Consulta ---
# Cada cuánto se pregunta la cantidad de espectadores (ms). 15000 = 15 s (seguro para la cuota de YouTube).
INTERVALO_MS=15000
INTERVALO_SIMULADOR_MS=1000

# --- Mapeo espectadores -> ángulo del servo ---
MAPEO_MODO=lineal          # lineal | logaritmico | auto
VIEWERS_MIN=0
VIEWERS_MAX=1000
ANGULO_MIN=0
ANGULO_MAX=180
INVERTIR=false
SUAVIZADO=0.5              # 1 = sin suavizado, 0.1 = muy suave
ZONA_MUERTA=2              # grados mínimos de cambio para mover el servo
SIN_SENAL=minimo           # minimo | mantener

# --- Placa (se puede configurar también desde el panel) ---
HARDWARE_TIPO=ninguno      # ninguno | http | serial
ESP8266_IP=192.168.1.100
PUERTO_SERIE=COM5
BAUDIOS=115200

# --- YouTube con OAuth 2.0 (alternativa a la API key; mismas credenciales que el Proyecto B) ---
# Después de completar, iniciar sesión desde el panel con "Iniciar sesión con Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe estar registrada en Google Cloud Console (es la misma que usa el Proyecto B).
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
